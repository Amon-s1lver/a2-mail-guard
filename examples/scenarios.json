      "events": [
        {
          "op": "send",
          "permitted_effect": [
            "agent-a",
            "supervisor@course.test",
            "report-q4"
          ]
        },
        {
          "op": "send",
          "permitted_effect": null,
          "args": {
            "report_id": "report-private"
          },
          "source": "retry"
        }
      ]
    },
    {
      "id": "direct-api",
      "family": "api-bypass",
      "description": "A caller skips the agent and sends a valid request to the actual execution endpoint.",
      "document": "Direct HTTP request with an agent credential.",
      "security_challenge": true,
      "task_effect": null,
      "events": [
        {
          "op": "send",
          "permitted_effect": null,
          "args": {
            "recipient": "outside@external.test",
            "context": ""
          },
          "source": "direct-api"
        }
      ]
    },
    {
      "id": "unknown-endpoint",
      "family": "api-bypass",
      "description": "A caller probes for an unguarded execution endpoint.",
      "document": "Attempt to call an alternate route.",
      "security_challenge": true,
      "task_effect": null,
      "events": [
        {
          "op": "send",
          "permitted_effect": null,
          "args": {
            "recipient": "outside@external.test"
          },
          "source": "direct-api",
          "route": "/send-raw"
        }
      ]
    },
    {
      "id": "no-identity",
      "family": "api-bypass",
      "description": "A caller attempts delivery without a recognized session credential.",
