    {
      "id": "invalid-report-type",
      "family": "validation",
      "description": "The report identifier is an array.",
      "document": "An unexpected structured argument reaches the API.",
      "security_challenge": true,
      "task_effect": null,
      "events": [
        {
          "op": "send",
          "permitted_effect": null,
          "args": {
            "report_id": [
              "report-q4",
              "report-private"
            ]
          }
        }
