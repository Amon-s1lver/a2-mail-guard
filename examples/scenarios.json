      "security_challenge": true,
      "task_effect": null,
      "events": [
        {
          "op": "send",
          "permitted_effect": null,
          "args": {},
          "principal": "unknown",
          "source": "direct-api"
        }
      ]
    },
    {
      "id": "spoof-principal",
      "family": "api-bypass",
      "description": "A request attempts to overwrite the authenticated identity.",
      "document": "The payload claims to come from the authorized agent.",
      "security_challenge": true,
      "task_effect": null,
      "events": [
        {
          "op": "send",
          "permitted_effect": null,
          "args": {
            "principal": "agent-a"
          },
          "principal": "agent-b",
          "source": "direct-api"
        }
      ]
    },
    {
      "id": "multiple-recipients",
      "family": "validation",
      "description": "A single-recipient field contains a second address.",
      "document": "A second recipient is injected into the address argument.",
      "security_challenge": true,
      "task_effect": null,
      "events": [
        {
          "op": "send",
          "permitted_effect": null,
          "args": {
            "recipient": "supervisor@course.test, outside@external.test"
          }
        }
      ]
    },
    {
      "id": "header-injection",
      "family": "validation",
      "description": "The address includes a line break and a Bcc header.",
      "document": "A second recipient is injected through a header.",
      "security_challenge": true,
      "task_effect": null,
      "events": [
        {
          "op": "send",
          "permitted_effect": null,
          "args": {
            "recipient": "supervisor@course.test\r\nBcc: outside@external.test"
          }
        }
      ]
